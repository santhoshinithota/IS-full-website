# Copy to .env in this folder:  cp env.example .env
# Then edit values for your machine.

MONGO_URI=mongodb://127.0.0.1:27017/storytime
JWT_SECRET=change-this-to-a-long-random-string
# Comma-separated extra origins if needed (localhost + 127.0.0.1 Vite ports are allowed in dev by default).
FRONTEND_URL=http://localhost:5173
PORT=5000

# In production, set NODE_ENV=production so CORS only allows FRONTEND_URL (plus localhost defaults).
# Leave unset locally: the API accepts any browser Origin in development.
